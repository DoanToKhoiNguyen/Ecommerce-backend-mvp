generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. Bảng Role (Vai trò)
model Role {
  roleid   Int    @id @default(autoincrement())
  rolename String @db.VarChar(50)

  users User[]

  @@map("Role")
}

// 2. Bảng MemberShip (Hạng thành viên)
model MemberShip {
  mid   Int    @id @default(autoincrement())
  mname String @db.VarChar(50)
  score Int    @default(0)

  users User[]

  @@map("MemberShip")
}

// 3. Bảng User (Người dùng)
model User {
  uid      Int    @id @default(autoincrement())
  username String @unique @db.VarChar(50)
  fullname String @db.VarChar(100)
  password String @db.VarChar(255)
  roleid   Int
  mid      Int

  role       Role       @relation(fields: [roleid], references: [roleid])
  membership MemberShip @relation(fields: [mid], references: [mid])
  orders     Order[]

  @@map("User")
}

// 4. Bảng Product (Sản phẩm)
model Product {
  pid      Int     @id @default(autoincrement())
  pname    String  @db.VarChar(100)
  price    Decimal @db.Decimal(10, 2)
  quantity Int     @default(0)

  orderDetails OrderDetail[]

  @@map("Product")
}

// 5. Bảng Order (Đơn hàng)
model Order {
  oid      Int      @id @default(autoincrement())
  uid      Int
  createat DateTime @default(now()) @db.Timestamp

  user         User          @relation(fields: [uid], references: [uid])
  orderDetails OrderDetail[]
  shipments    Shipment[]

  @@map("Order")
}

// 6. Bảng OrderDetail (Chi tiết đơn hàng)
model OrderDetail {
  oid        Int
  pid        Int
  qty        Int
  unit_price Decimal @db.Decimal(10, 2)

  order   Order   @relation(fields: [oid], references: [oid])
  product Product @relation(fields: [pid], references: [pid])

  @@id([oid, pid])
  @@map("OrderDetail")
}

// 7. Bảng Shipment (Vận chuyển)
model Shipment {
  shipid Int    @id @default(autoincrement())
  oid    Int
  status String @db.VarChar(50)

  order Order @relation(fields: [oid], references: [oid])

  @@map("Shipment")
}